---
import { pages, sharedPart } from '../lib/content.mjs';
import { applyLangHrefs, applyActiveNav, parseTagAttrs } from '../lib/render.mjs';

export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.localizedPath === '/' ? undefined : page.localizedPath.slice(1) },
    props: { page },
  }));
}

const { page } = Astro.props;
const staging = !!process.env.STAGING;

const htmlAttrs = parseTagAttrs(page.htmlAttrs);
const bodyAttrs = parseTagAttrs(page.bodyAttrs);

const headShared = sharedPart(page.locale, page.headFile);
let prelude = sharedPart(page.locale, page.preludeFile);
let postlude = sharedPart(page.locale, page.postludeFile);
prelude = applyActiveNav(applyLangHrefs(prelude, page.path), page.activeNav);
postlude = applyLangHrefs(postlude, page.path);

// dedupe: Shopify emits the identical featured-product schema twice on the homepage
const ldjson = [...new Set([...(page.ldjson || []), ...(page.ldjsonBody || [])])];

// og:image & friends must be absolute; asset URLs were localized to /assets/...
const site = (Astro.site?.href || 'https://silverbullet.tools/').replace(/\/$/, '');
const og = (page.og || []).map((s) => s.replaceAll('content="/assets/', `content="${site}/assets/`));

// og:locale reflects the CONTENT language (html lang attr - the live site
// serves untranslated EN product pages under locale prefixes)
const OG_LOCALE = { en: 'en_US', fr: 'fr_FR', de: 'de_DE', it: 'it_IT', es: 'es_ES' };
const contentLang = (page.htmlAttrs.match(/lang="([a-z]{2})"/) || [])[1] || 'en';
const ogLocale = OG_LOCALE[contentLang] || 'en_US';
const ogLocaleAlternates = page.hreflang
  .filter((h) => h.lang !== 'x-default' && OG_LOCALE[h.lang] && OG_LOCALE[h.lang] !== ogLocale)
  .map((h) => OG_LOCALE[h.lang]);

// blog index & collection templates ship no meta description; reuse og:description
let description = page.description;
if (!description) {
  const m = (page.og || []).find((s) => s.includes('property="og:description"'))?.match(/content="([^"]*)"/);
  if (m) description = m[1].replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>');
}
---

<html {...htmlAttrs}>
  <head>
    <Fragment set:html={headShared} />
    <title>{page.title}</title>
    {description && <meta name="description" content={description} />}
    {page.canonical && <link rel="canonical" href={page.canonical} />}
    {page.hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    <Fragment set:html={og.join('\n')} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <Fragment set:html={(page.headExtras || []).join('\n')} />
    {ldjson.map((s) => <script type="application/ld+json" set:html={s} />)}
    {staging && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body {...bodyAttrs}>
    <Fragment set:html={prelude} />
    <Fragment set:html={page.mainHtml} />
    <Fragment set:html={postlude} />
  </body>
</html>
